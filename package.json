{
  "name": "@fugood/react-native-video-player",
  "version": "1.0.0-beta.0",
  "description": "Video player for React Native, Apple TV and Android TV, built on the platform's own player APIs",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "@fugood/react-native-video-player-source": "./src/index.tsx",
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @fugood/react-native-video-player-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build example-tv/android/build example-tv/android/app/build example-tv/ios/build example-legacy/android/build example-legacy/android/app/build example-legacy/ios/build lib",
    "prepare": "bob build",
    "release": "release-it --only-version",
    "example-tv": "yarn workspace @fugood/react-native-video-player-example-tv",
    "example-legacy": "yarn workspace @fugood/react-native-video-player-example-legacy"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "tvos",
    "androidtv",
    "react-native-tvos",
    "video",
    "player",
    "avplayer",
    "mediaplayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mybigday/react-native-video-player.git"
  },
  "author": "Hans <hans.chen@bricks.tools> (https://github.com/mybigday/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mybigday/react-native-video-player/issues"
  },
  "homepage": "https://github.com/mybigday/react-native-video-player#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.0",
    "@evilmartians/lefthook": "^2.1.10",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.2",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^21.0.2",
    "test-renderer": "^1.2.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example",
    "example-tv",
    "example-legacy"
  ],
  "resolutions": {
    "fast-xml-parser@npm:^4.4.1": "npm:^5.7.0"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">= 20.0.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "@fugood/react-native-video-player-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNReactNativeVideoPlayerViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.fugood.reactnativevideoplayer"
    },
    "ios": {
      "components": {
        "ReactNativeVideoPlayerView": {
          "className": "ReactNativeVideoPlayerView"
        }
      }
    }
  }
}
